<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="#FFFFFF"
    tools:context=".projects">

    <!-- Icon and Text Positioned Side by Side -->
    <LinearLayout
        android:id="@+id/linearLayoutTop"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="5dp"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/project_kabab"
            android:layout_width="41dp"
            android:layout_height="35dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/menu_icon" />

        <TextView
            android:id="@+id/projects1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Projects"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Horizontal Line Below the Icon and Text -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@id/linearLayoutTop"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#D3D3D3" />

    <!-- Description Text Below the Line -->
    <TextView
        android:id="@+id/projects2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/linearLayoutTop"
        android:layout_marginStart="5dp"
        android:layout_marginTop="30dp"
        android:text="Find new projects in Pakistan"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Button Bar Positioned Below the Text -->
    <LinearLayout
        android:id="@+id/projects_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/projects2"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <Button
            android:id="@+id/project_btn1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/project_button"
            android:text="Filters"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/project_btn2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/project_button"
            android:text="City"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/project_btn3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/project_button"
            android:text="Price Range"
            android:textColor="@color/black" />
    </LinearLayout>

    <!-- Display the number of projects and sorting method -->


    <LinearLayout
        android:id="@+id/projects4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/projects_btn"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="0dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:text="1232 Projects in Pakistan"
            android:textColor="#6B6868"
            android:textSize="16sp" />

        <!-- Spacer to push the following items to the right -->

        <!-- Popularity icon -->
        <View
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- Popularity text -->

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/popularity_icon" />

        <TextView
            android:id="@+id/popularity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:text="Popularity"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- List item view for project details -->
    <LinearLayout
        android:id="@+id/project_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/projects4"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="10dp"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Project Image -->
        <ImageView
            android:id="@+id/project_image"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_weight="1"
            android:scaleType="centerCrop"
            android:src="@drawable/project1" />

        <!-- Description layout -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical"
            android:paddingLeft="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/marketedby"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:backgroundTint="#FFFFFF"
                    android:drawablePadding="8dp"
                    android:text="Marketed by"
                    android:textColor="@color/black" />

                <ImageView
                    android:id="@+id/iconImageView"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon" />
            </LinearLayout>





            <TextView
                android:id="@+id/project_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="88.05 Lakh to 3.91 Crore"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/project_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Zameen Jade - Sukh Chayn Gardens, Lahore"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <Button
                android:id="@+id/property_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:text="Flats"
                android:textColor="@color/black" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/share_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/message" />

                <ImageView
                    android:id="@+id/whatsapp_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/whatsappp" />

                <Button
                    android:id="@+id/call_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#4CAF50"
                    android:text="Call"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


    <!-- List item view for project details -->
    <LinearLayout
        android:id="@+id/project_details2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/project_details"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="10dp"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Project Image -->
        <ImageView
            android:id="@+id/project_image2"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_weight="1"
            android:scaleType="centerCrop"
            android:src="@drawable/project2" />

        <!-- Description layout -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical"
            android:paddingLeft="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/marketedby2"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:backgroundTint="#FFFFFF"
                    android:drawablePadding="8dp"
                    android:text="Marketed by"
                    android:textColor="@color/black" />

                <ImageView
                    android:id="@+id/iconImageView2"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon" />
            </LinearLayout>





            <TextView
                android:id="@+id/project_price2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="88.05 Lakh to 3.91 Crore"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/project_name2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Zameen Jade - Sukh Chayn Gardens, Lahore"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <Button
                android:id="@+id/property_type2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:text="Flats"
                android:textColor="@color/black" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/share_button2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/message" />

                <ImageView
                    android:id="@+id/whatsapp_button2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/whatsappp" />

                <Button
                    android:id="@+id/call_button2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#4CAF50"
                    android:text="Call"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- List item view for project details -->
    <LinearLayout
        android:id="@+id/project_details3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/project_details2"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="10dp"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Project Image -->
        <ImageView
            android:id="@+id/project_image3"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_weight="1"
            android:scaleType="centerCrop"
            android:src="@drawable/project3" />

        <!-- Description layout -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical"
            android:paddingLeft="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/marketedby3"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:backgroundTint="#FFFFFF"
                    android:drawablePadding="8dp"
                    android:text="Marketed by"
                    android:textColor="@color/black" />

                <ImageView
                    android:id="@+id/iconImageView3"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon" />
            </LinearLayout>





            <TextView
                android:id="@+id/project_price3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="88.05 Lakh to 3.91 Crore"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/project_name3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Zameen Jade - Sukh Chayn Gardens, Lahore"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <Button
                android:id="@+id/property_type3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:text="Flats"
                android:textColor="@color/black" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/share_button3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/message" />

                <ImageView
                    android:id="@+id/whatsapp_button3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/whatsappp" />

                <Button
                    android:id="@+id/call_button3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#4CAF50"
                    android:text="Call"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


</RelativeLayout>



