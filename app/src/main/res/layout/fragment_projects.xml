                android:id="@+id/projectsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Projects"
                android:textSize="16sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/baseline_arrow_back_ios_24"
                android:drawablePadding="8dp"
                android:layout_gravity="start"
                android:layout_marginBottom="24dp" />

            <!--<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filters"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginEnd="16dp" />-->
        </LinearLayout>

        <!-- Search Filters Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Projects"
                android:backgroundTint="#AFAEAE" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:layout_marginStart="8dp"
                android:backgroundTint="#AFAEAE" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flats"
                android:layout_marginStart="8dp"
                android:backgroundTint="#AFAEAE" />

            <!--            <Button-->
            <!--                android:layout_width="wrap_content"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:text="Area Range"-->
            <!--                android:layout_marginStart="8dp"-->
            <!--                android:backgroundTint="#AFAEAE" />-->
        </LinearLayout>

        <!-- Marketed by Zameen Switch Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:background="#F8B2E0C6"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Marketed by Zameen.com"
                android:textColor="@color/green"
                android:textSize="16sp" />

            <Switch
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:thumbTint="@color/green" />
        </LinearLayout>

