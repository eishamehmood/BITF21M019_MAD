        <!-- City Section -->
        <LinearLayout
            android:id="@+id/city_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/header_background"
            app:layout_constraintStart_toStartOf="parent">


            <!--<ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/location_ic" />--> <!-- Replace with your city icon drawable -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/addcityLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="City"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/baseline_location_on_24"
                        android:drawablePadding="6dp" />

                    <ImageView
                        android:id="@+id/addcityArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/arrow_forward_ios_24"
                        android:contentDescription="Select City" />
                </LinearLayout>




                <TextView
                    android:id="@+id/addcityName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Lahore"
                    android:textColor="@android:color/holo_green_dark"
                    android:textSize="16sp"  />
            </LinearLayout>


        </LinearLayout>


        <TextView
            android:id="@+id/selectLocationsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Select Locations"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/city_section"
            android:textStyle="bold" />

        <!-- Select Location Section -->
        <LinearLayout
            android:id="@+id/location_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@id/city_section"
            app:layout_constraintStart_toStartOf="parent">




            <LinearLayout
                android:id="@+id/locations_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">


                <AutoCompleteTextView
                    android:id="@+id/locationEditText"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Enter Location"
                    android:drawableEnd="@drawable/search_icon">

                </AutoCompleteTextView>





            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:id="@+id/area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/location_text"
            app:layout_constraintStart_toStartOf="parent">


            <!--<ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/location_ic" />--> <!-- Replace with your city icon drawable -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/addmarlaLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Area Size"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/baseline_location_on_24"
                        android:drawablePadding="6dp" />

                    <ImageView
                        android:id="@+id/addmarlaArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/arrow_forward_ios_24"
                        android:contentDescription="Select City" />
                </LinearLayout>




                <TextView
                    android:id="@+id/addselectedmarla"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="8 marla"
                    android:textColor="#9FA09B"
                    android:textSize="16sp"  />
            </LinearLayout>


        </LinearLayout>



        <!-- Total Price Section -->
        <LinearLayout
            android:id="@+id/totalprice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/area"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/total_price" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Price"
                    android:textSize="16sp"
                    android:textColor="@android:color/black" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter amount"
                    android:inputType="number"
                    android:minHeight="48dp"
                    android:padding="8dp"
                    android:textColorHint="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/pkr0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="PKR 0"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRICE CHECK"
                android:textColor="#A1A1A1"
                android:backgroundTint="@android:color/transparent"
                android:layout_marginEnd="8dp"
                android:drawableEnd="@drawable/price_check" />
        </LinearLayout>

        <!-- Installments Available Toggle -->
        <LinearLayout
            android:id="@+id/installments_available"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/totalprice"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">



            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Installments Available"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_marginStart="16dp"
                android:layout_weight="1" />

            <Switch
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>

        <!-- Ready for Possession Toggle -->
        <LinearLayout
            android:id="@+id/posession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/installments_available"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">



            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Ready for Possession"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_marginStart="16dp"
                android:layout_weight="1" />

            <Switch
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical" />


        </LinearLayout>
        <LinearLayout
            android:id="@+id/bedrooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/posession"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/bedroom_ic" /> <!-- Replace with your bedrooms icon -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bedrooms"
                    android:textSize="16sp"
                    android:textColor="@android:color/black"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="8"
                android:layout_marginTop="8dp">

                <!-- Bedroom Options -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Studio"
                    android:padding="8dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/rounded_button_background_inactive"
                    android:textColor="@color/black" />

                <!-- Repeat the following for each Bedroom option (1-10) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:padding="8dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/rounded_button_background_inactive"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:padding="8dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/rounded_button_background_inactive"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:padding="8dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/rounded_button_background_inactive"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:padding="8dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/rounded_button_background_inactive"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:padding="8dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/rounded_button_background_inactive"
                    android:textColor="@color/black" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6"
                    android:padding="8dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/rounded_button_background_inactive"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7"
                    android:padding="8dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/rounded_button_background_inactive"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8"
                    android:padding="8dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/rounded_button_background_inactive"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9"
                    android:padding="8dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/rounded_button_background_inactive"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10"
                    android:padding="8dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/rounded_button_background_inactive"
                    android:textColor="@color/black" />

                <!-- Continue similarly for options 3-10 -->
            </GridLayout>
        </LinearLayout>

