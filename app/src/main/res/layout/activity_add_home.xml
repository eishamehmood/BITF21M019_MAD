                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:padding="8dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/rounded_button_background_inactive"
                    android:textColor="@color/black" />

                <TextView
